# Copy to retouch-server.env (git-ignored), chmod 600, and fill in the token.
# Generate a token once, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This token is for the skin retouch server only; never reuse the MonetGPT / SAM 3 token.
RETOUCH_AUTH_TOKEN=

# Model files: acne_640_fp32.onnx + acne_640_fp32.manifest.json, migan_pipeline_v2.onnx
RETOUCH_MODEL_DIR=/home/jaeho/.cache/vibe-retouch

# Wire names, comma separated: blemish,shine,dark_circles,shaving_shadow
# ENABLED kinds are offered to the app (health supported_kinds). Only kinds whose SR1 quality gate
# has passed (app/config.py QUALIFIED_KINDS) are accepted; none has yet, so leave it empty.
# EVALUATION kinds are loaded and callable by the smoke/evaluation tools, never offered to the app.
# Health is 503 "failed" if any loaded engine fails to load.
RETOUCH_ENABLED_KINDS=
RETOUCH_EVALUATION_KINDS=blemish

# Backend listen address (loopback only; the public port is the Caddy proxy).
RETOUCH_HOST=127.0.0.1
RETOUCH_PORT=8084

# Admission and deadline (wire contract v1 defaults: 1 running, 4 waiting, 55 s wait+run).
RETOUCH_MAX_RUNNING=1
RETOUCH_MAX_QUEUED=4
RETOUCH_JOB_DEADLINE_S=55

# auto = CUDA execution provider with CPU fallback; cpu = never use the GPU.
RETOUCH_EXECUTION_PROVIDER=auto
# Per-session CUDA arena cap (two sessions: detector + MI-GAN). The T4 is shared.
RETOUCH_GPU_MEM_LIMIT_MB=2048
