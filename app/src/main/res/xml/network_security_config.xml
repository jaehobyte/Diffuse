<?xml version="1.0" encoding="utf-8"?>
<!--
  specs/segmentation.md §6. The SAM 3 base URL is user-configurable, so this is what decides
  which of those URLs may be plain HTTP.

  Only loopback is allowed: 10.0.2.2 is the emulator's route to the host, and 127.0.0.1 is what
  `adb reverse tcp:8080 tcp:8080` gives a USB-attached device. Anything else — that is, any real
  deployment — must be HTTPS, which is exactly what the server's Caddy front door is for.

  `usesCleartextTraffic="true"` would have been one attribute, but it would also let a typo in
  the settings sheet send an image and a bearer token over the open network in the clear.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
